# sqmusic-mod check_update.sh configuration example
# Copy this file to .env and adjust values for your deployment.

# Container and network naming
CONTAINER_MAIN=sqmusic_mod_main
CONTAINER_WEB=sqmusic_mod_web
CONTAINER_MYSQL=sqmusic_mod_mysql
NETWORK_NAME=sq-mod-network

# Database connection used by sqmusic_main
DB_IP=mysql
DB_PORT=3306
DB_NAME=sqmusicv3
DB_USERNAME=root
DB_PASSWORD=sqmusicv3password

# Mounts and ports
MUSIC_DIR_HOST=/mnt/hdd/sqmusic
MUSIC_DIR_CONTAINER=/music
WEB_PORT_MAPPING=8098:80
# MAIN_PORT_MAPPING=8099:8099

# Release and images
RELEASE_REPO=kennysoul/simple_sq_music_plus_mod
IMAGE_MAIN=ghcr.io/kennysoul/simple_sq_music_plus_mod
IMAGE_WEB=ghcr.io/kennysoul/simple_sq_music_plus_web_mod
